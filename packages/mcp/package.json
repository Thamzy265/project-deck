{
  "name": "@project-deck/mcp",
  "version": "0.0.0",
  "description": "project-deck MCP server: a stdio client of the project's daemon for Claude (deck_status, get_logs).",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@project-deck/core": "workspace:*",
    "@project-deck/daemon": "workspace:*",
    "zod": "^4.6.5"
  }
}
