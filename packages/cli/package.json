{
  "name": "@project-deck/cli",
  "version": "0.0.0",
  "description": "project-deck command line: init, start, stop, open and mcp for a Flutter project.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flutterdeck": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@project-deck/android-adb": "workspace:*",
    "@project-deck/core": "workspace:*",
    "@project-deck/daemon": "workspace:*",
    "@project-deck/mcp": "workspace:*",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
