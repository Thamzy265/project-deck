{
  "name": "@project-deck/dashboard",
  "version": "0.0.0",
  "description": "project-deck dashboard: the web page the daemon serves in Claude Desktop's Browser pane.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "dev": "vite",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@project-deck/core": "workspace:*",
    "@tanstack/react-virtual": "3.14.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "28.1.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  }
}
